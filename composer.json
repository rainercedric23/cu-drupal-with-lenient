    "scripts": {
        "post-drupal-scaffold-cmd": [
            "cd web && patch -p1 < ../patches/htaccess.patch",
            "echo 'Disallow: /zaraz/' >> web/robots.txt",
            "echo 'Disallow: /zaraz/*' >> web/robots.txt"
        ],
        "post-install-cmd": [
            "bash -c \"if [[ -n '$CI' || -n '$PANTHEON_ENVIRONMENT' ]]; then cd web/profiles && mv custom contrib || true; fi\"",
            "bash -c \"if [[ -n '$CI' || -n '$PANTHEON_ENVIRONMENT' ]]; then cd web/themes/custom/schwabe_base && ./build.sh; fi\""
        ],
        "post-update-cmd": [
            "bash -c \"if [[ -n '$CI' || -n '$PANTHEON_ENVIRONMENT' ]]; then cd web/profiles && mv custom contrib || true; fi\"",
            "bash -c \"if [[ -n '$CI' || -n '$PANTHEON_ENVIRONMENT' ]]; then cd web/themes/custom/schwabe_base && ./build.sh; fi\""
        ]
    },
